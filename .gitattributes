# Line endings, stated per file type rather than globally. Same shape as the
# two sites this comes from, including rules for the extensionless files that
# no extension-based rule reaches.
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.css  text eol=lf
*.sql  text eol=lf
*.html text eol=lf

Dockerfile     text eol=lf
.dockerignore  text eol=lf

# Git hooks are run through sh, and a CRLF shebang gives "/bin/sh^M: bad
# interpreter". The file tested fine in the working copy and would have broken
# on the next fresh checkout — git said so on commit and the warning was nearly
# scrolled past.
.githooks/*    text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Derived index artifacts are brotli. Never touch them.
*.br binary

# Fonts, same rule and a worse failure. `.ttf` was left unspecified and git's own
# binary detection would probably have got it right -- probably is not good
# enough for a file whose corruption shows up as a social card with no words on
# it rather than as an error.
*.ttf binary

# The font licence has no extension, like the hooks above, so no extension rule
# reaches it. It is text and should be checked out as text.
data/fonts/LICENSE text eol=lf

# Fetched sources are whatever upstream sent.
*.csv -text
